{
  "name": "bleague-stats",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node -e \"if(!process.env.CI){try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}}\"",
    "predev": "node --experimental-strip-types scripts/build-data.ts --if-missing",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "scrape:schedule": "node --experimental-strip-types scripts/scrape-schedule.ts",
    "scrape:boxscore": "node --experimental-strip-types scripts/scrape-boxscore.ts",
    "scrape:roster": "node --experimental-strip-types scripts/scrape-roster.ts",
    "scrape:player-awards": "node --experimental-strip-types scripts/scrape-player-awards.ts",
    "colors:extract": "node --experimental-strip-types scripts/extract-team-colors.ts",
    "scrape:club-honors": "node --experimental-strip-types scripts/scrape-club-honors.ts",
    "scrape:division-history": "node --experimental-strip-types scripts/scrape-division-history.ts",
    "scrape:yahoo-pbp": "node --experimental-strip-types scripts/scrape-yahoo-pbp.ts",
    "backfill:legacy-photos": "node --experimental-strip-types scripts/backfill-legacy-player-photos.ts",
    "aggregate": "node --experimental-strip-types scripts/aggregate.ts",
    "aggregate:league-rankings": "node --experimental-strip-types scripts/aggregate-league-rankings.ts",
    "aggregate:league-player-rankings": "node --experimental-strip-types scripts/aggregate-league-player-rankings.ts",
    "aggregate:player-careers": "node --experimental-strip-types scripts/aggregate-player-careers.ts",
    "aggregate:league-player-game-records": "node --experimental-strip-types scripts/aggregate-league-player-game-records.ts",
    "aggregate:player-game-records": "node --experimental-strip-types scripts/aggregate-player-game-records.ts",
    "freeze:season-profiles": "node --experimental-strip-types scripts/freeze-season-profiles.ts",
    "aggregate:league-compare": "esbuild scripts/aggregate-league-compare.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/aggregate-league-compare.mjs && node node_modules/.cache/aggregate-league-compare.mjs",
    "print:current-season": "node --experimental-strip-types scripts/print-current-season.ts",
    "watchlist": "node --experimental-strip-types scripts/game-watchlist.ts",
    "validate:oncourt": "node --experimental-strip-types scripts/validate-oncourt.ts",
    "check:rule-change": "node --experimental-strip-types scripts/check-rule-change.ts",
    "validate:points-off-turnovers": "node --experimental-strip-types scripts/validate-points-off-turnovers.ts",
    "typecheck": "tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:data": "node --experimental-strip-types scripts/build-data.ts",
    "validate:lineup-search": "esbuild scripts/validate-lineup-search.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/validate-lineup-search.mjs && node node_modules/.cache/validate-lineup-search.mjs",
    "validate:live-dead-tov": "esbuild scripts/validate-live-dead-tov.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/validate-live-dead-tov.mjs && node node_modules/.cache/validate-live-dead-tov.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
