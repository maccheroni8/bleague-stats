{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "data", "scripts/aggregate-league-compare.ts", "scripts/validate-lineup-search.ts", "scripts/validate-live-dead-tov.ts", "scripts/validate-pbp-order.ts", "scripts/validate-season-compare.ts", "scripts/validate-game-index.ts"]
}
